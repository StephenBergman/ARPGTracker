{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARPG Seasons",
  "version": "1.0.0",
  "identifier": "com.stephen.arpg-seasons",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ARPG Seasons",
        "width": 430,
        "height": 620,
        "minWidth": 380,
        "minHeight": 120,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Stephen",
    "copyright": "Copyright © 2026 Stephen",
    "category": "Utility",
    "shortDescription": "ARPG season information and countdowns at a glance.",
    "longDescription": "A lightweight Windows desktop widget for tracking current and upcoming seasons across popular action RPGs.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
