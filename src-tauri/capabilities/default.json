{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "snap-overlay"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-set-position",
    "core:window:allow-center",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-always-on-bottom",
    "core:window:allow-set-skip-taskbar",
    "core:window:allow-set-ignore-cursor-events",
    "core:webview:allow-create-webview-window",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://web.poecdn.com/api/currency-exchange/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://maxroll.gg/**"
        },
        {
          "url": "https://poe.ninja/**"
        },
        {
          "url": "https://torchlight.xd.com/**"
        },
        {
          "url": "https://www.projectdiablo2.com/**"
        },
        {
          "url": "https://news.blizzard.com/**"
        },
        {
          "url": "https://steamcommunity.com/**"
        },
        {
          "url": "https://store.steampowered.com/**"
        },
        {
          "url": "https://steamstore-a.akamaihd.net/**"
        },
        {
          "url": "https://www.pathofexile.com/**"
        },
        {
          "url": "https://pathofexile2.com/**"
        },
        {
          "url": "https://lastepoch.com/**"
        },
        {
          "url": "https://forum.lastepoch.com/**"
        },
        {
          "url": "https://github.com/StephenBergman/ARPGTracker/actions/**"
        }
      ]
    },
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
